# PnL Lens — environment template (.env at the repo root; git-ignored). See docs/ENVIRONMENT.md.
# Don't fill the secrets by hand: `npm run stack:env` generates every missing one and never changes existing values.

# ---- generated secrets -------------------------------------------------------------------------------
POSTGRES_USER=lens_admin
POSTGRES_PASSWORD=
LENS_APP_PASSWORD=
LENS_WORKER_PASSWORD=
REDIS_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# S3 keys for Garage: access key id = "GK" + 24 hex chars, secret = 64 hex chars
S3_API_ACCESS_KEY_ID=
S3_API_SECRET_ACCESS_KEY=
S3_WORKER_ACCESS_KEY_ID=
S3_WORKER_SECRET_ACCESS_KEY=
SESSION_SECRET=
OTP_PEPPER=
IP_HASH_SECRET=
# File-encryption key. FILE_KEK_<ID> = 64 hex chars. Never change a key while data uses it (rotation: docs/RUNBOOK.md)
FILE_KEK_ID=k1
FILE_KEK_K1=
# Throwaway test services (infra/compose.test.yml, 127.0.0.1 only, data in memory)
TEST_POSTGRES_PASSWORD=
TEST_REDIS_PASSWORD=

# ---- production accounts (add on the server only) ----------------------------------------------------
APP_URL=https://pnllens.com
DOMAIN=pnllens.com
# cloudflare (origin certificate in infra/certs/) | internal (self-signed, for a test VM)
TLS_MODE=cloudflare
# Images built by GitHub Actions (deploy.yml); leave unset to build on the server
# IMAGE_REGISTRY=ghcr.io/<owner>/pnl-lens
MAIL_DRIVER=resend
MAIL_FROM=PnL Lens <no-reply@pnllens.com>
RESEND_API_KEY=
# MAIL_DRIVER=smtp sends through Google Workspace/Gmail: SMTP_PASS is a Google App password
# (myaccount.google.com/apppasswords, needs 2-Step Verification), never the account password.
# MAIL_FROM must be the SMTP_USER mailbox or one of its "Send mail as" aliases.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Local dev stack only: console (codes in the API's .data/dev-mail.log) or smtp (really send)
DEV_MAIL_DRIVER=console
# Google Cloud Console → OAuth client (Web). Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# off | razorpay (docs/PAYMENTS_RAZORPAY.md). Plans are granted only by the verified webhook.
PAYMENTS_MODE=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRICING_DEFAULT_COUNTRY=US
# Off-site encrypted backups (restic), e.g. DigitalOcean Spaces: s3:https://blr1.digitaloceanspaces.com/<bucket>/pnl-lens
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ALERT_EMAIL=

# ---- optional ----------------------------------------------------------------------------------------
# WORKER_CONCURRENCY=2
# WORKER_MEM_LIMIT=2g
# ENGINE_TIMEOUT_MS=60000
# ENGINE_MEMORY_MB=512
# RETENTION_USAGE_MONTHS=12
# RETENTION_AUDIT_MONTHS=24
# Dev stack address (default 127.0.0.1:8080) and test ports
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080
# TEST_PG_PORT=55432
# TEST_REDIS_PORT=56379
# Timers in the api (all on by default; see docs/ENVIRONMENT.md)
# 30-day plan check-up reminder emails: checked every 10 min, sent from 09:00 IST
# PLAN_REMINDERS=on
# PLAN_REMINDER_INTERVAL_MS=600000
# PLAN_REMINDER_FROM_HOUR=9
# Weekly summary email (opt-in): checked every 15 min, sent from Monday 09:00 IST
# WEEKLY_DIGEST=on
# DIGEST_INTERVAL_MS=900000
# DIGEST_FROM_HOUR=9
# India market data (NIFTY 50, NIFTY BANK, India VIX) from Upstox's public API, NSE fallback; needs outbound HTTPS
# MARKET_SYNC=on
# MARKET_SYNC_INTERVAL_MS=3600000
