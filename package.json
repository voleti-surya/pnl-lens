{
  "name": "pnl-lens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/engine",
    "packages/shared",
    "packages/db",
    "apps/web",
    "apps/api",
    "apps/worker"
  ],
  "scripts": {
    "dev": "npm run dev -w @pnl-lens/web",
    "build": "npm run build -w @pnl-lens/web",
    "start": "npm run start -w @pnl-lens/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "db:migrate": "npm run migrate -w @pnl-lens/db",
    "db:purge": "npm run purge -w @pnl-lens/db",
    "docs:index": "node scripts/gen-index.mjs",
    "stack:env": "node infra/scripts/gen-env.mjs",
    "stack:up": "docker compose --env-file .env -f infra/compose.dev.yml up -d --build --wait",
    "stack:down": "docker compose --env-file .env -f infra/compose.dev.yml down",
    "stack:logs": "docker compose --env-file .env -f infra/compose.dev.yml logs -f --tail=100",
    "test:stack": "vitest run --config tests/stack/vitest.config.ts",
    "db:test:up": "docker compose --env-file .env -f infra/compose.test.yml up -d --wait",
    "db:test:down": "docker compose --env-file .env -f infra/compose.test.yml down -v",
    "test:db": "npm run test:db -w @pnl-lens/db",
    "test:e2e": "playwright test",
    "stack:e2e": "docker compose --env-file .env -f infra/compose.dev.yml -f infra/compose.e2e.yml up -d --build --wait",
    "stack:signin": "docker compose --env-file .env -f infra/compose.dev.yml -f infra/compose.e2e.yml -f infra/compose.mail.yml up -d --build --wait",
    "audit:prod": "node infra/scripts/audit.mjs",
    "check:secrets": "bash infra/scripts/check-secrets.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.70.1",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "postcss": "8.5.29",
    "source-map-js": "1.2.2",
    "argparse": "3.0.3"
  }
}
